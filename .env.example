# ==============================================================================
# Customer Intelligence Platform - Environment Variables Template
# Copy this file to .env and fill in the values. Do not commit .env to Git.
# ==============================================================================

# Application Environment
ENV=development                  # development, testing, staging, production
DEBUG=true                       # true, false
APP_VERSION=1.0.0

# FastAPI Server Settings
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_me_to_a_random_32_character_string_for_production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cip_user
DB_PASSWORD=cip_secure_password
DB_NAME=customer_intelligence
DB_SSL_MODE=disable              # disable, require, verify-ca, verify-full

# Logging Settings
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=logs
LOG_FILE_NAME=app.log
