# ==============================================================================
# Customer Intelligence Platform - Production Environment Configuration
# ==============================================================================

ENV=production
DEBUG=false
APP_VERSION=1.0.0
SECRET_KEY=cip_prod_super_secret_jwt_key_change_me_in_vault

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cip_db
DB_USER=cip_user
DB_PASSWORD=cip_prod_secret_pass

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
SCHEDULER_ENABLED=true

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_SIZE_MB=25
ALLOWED_ORIGINS=https://cip.example.com,http://localhost

# MLOps & Alerting
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=alerts@example.com
DRIFT_WARNING_THRESHOLD=0.10
DRIFT_CRITICAL_THRESHOLD=0.25
